@model LibraryManagementSystem.Models.Book

<h2>Create Book</h2>

<form asp-action="Create">

    <div>
        <label>Title</label>

        <input asp-for="Title" class="form-control" />
    </div>

    <br />

    <div>
        <label>Author ID</label>

        <input asp-for="AuthorID" class="form-control" />
    </div>

    <br />

    <button type="submit">Save</button>

</form>