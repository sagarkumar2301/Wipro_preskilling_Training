@model BookStoreApp.Models.Book

<h2>Add Book</h2>

<form asp-action="Create">

    <div>
        <label>Title</label>
        <input asp-for="Title" />
    </div>

    <div>
        <label>Author</label>
        <input asp-for="Author" />
    </div>

    <div>
        <label>Price</label>
        <input asp-for="Price" />
    </div>

    <div>
        <label>Quantity</label>
        <input asp-for="Quantity" />
    </div>

    <button type="submit">Save</button>

</form>