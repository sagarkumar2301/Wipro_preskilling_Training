<h2>HR Dashboard</h2>

<div class="row">
    <div class="col-md-3">
        <div class="card p-3">
           
                <h4>Total Employees</h4>
                <h2>@ViewBag.TotalEmployees</h2>
            
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
           
                <h4>Active Employees</h4>
                <h2>@ViewBag.ActiveEmployees</h2>
            </div>
        </div>
    
    <div class="col-md-3">
        <div class="card p-3">
            
                <h4>Total Leave Requests</h4>
                <h2>@ViewBag.TotalLeaveRequests</h2>
            </div>
        </div>
    
    <div class="col-md-3">
        <div class="card p-3">
            
                <h4>Pending Leave Requests</h4>
                <h2>@ViewBag.PendingLeaveRequests</h2>
            </div>
        </div>

    <h3>Department Statistics</h3>

    <div class="row">

        <div class="col-md-3">
            <div class="card p-3">
                <h5>HR</h5>
                <h2>@ViewBag.HRCount</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>IT</h5>
                <h2>@ViewBag.ITCount</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Finance</h5>
                <h2>@ViewBag.FinanceCount</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Sales</h5>
                <h2>@ViewBag.SalesCount</h2>
            </div>
        </div>

    </div>
    
</div>