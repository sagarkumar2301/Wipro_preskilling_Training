<form asp-action="Login" method="post">

    <div>
        <label>Email</label>
        <input name="email" class="form-control" />
    </div>

    <div>
        <label>Password</label>
        <input name="password"
               type="password"
               class="form-control" />
    </div>

    <button type="submit">Login</button>

</form>